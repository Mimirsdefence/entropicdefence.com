# ─────────────────────────────────────────────────────────────────────
#  Entropic Defence — mejlagenter
#  Kopiera den har filen till agents/.env och fyll i vardena.
#  Committa ALDRIG .env — den innehaller riktiga losenord.
# ─────────────────────────────────────────────────────────────────────

# ── Sprakmodell (valfri OpenAI-kompatibel leverantor: xAI, DeepSeek, OpenAI)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ── One.com:s mejlservrar (samma for alla tre brevlador)
IMAP_HOST=imap.one.com
SMTP_HOST=send.one.com
SMTP_PORT=465

# ── App-losenord per brevlada.
#    Skapa i One.com-panelen: E-post -> valj konto -> App-losenord.
#    Anvandarnamnet ar hela adressen, losenordet ar app-losenordet.
IMAP_USER_SUPPORT=
IMAP_PASS_SUPPORT=
IMAP_USER_SECURITY=
IMAP_PASS_SECURITY=
IMAP_USER_CONSULTANT=
IMAP_PASS_CONSULTANT=

# ── Dit gar eskaleringar och tysta flaggor (en mansklig brevlada du laser)
OWNER_EMAIL=pomzak@entropicdefence.com

# ── Beteende
#   MARK_AS_SEEN=true  -> agenten markerar hanterade mejl som lasta
#   MARK_AS_SEEN=false -> de ligger kvar som olasta sa du ser vad agenten gjort
MARK_AS_SEEN=true
#   PROCESS_BACKLOG=false -> svara bara pa mejl som kommer in efter start
#   PROCESS_BACKLOG=true  -> svara aven pa allt som redan ligger i brevlådan
PROCESS_BACKLOG=false

# ── Stripe (fakturor och betallankar for de fasta externpriserna)
#    Borja ALLTID med testnyckeln (sk_test_...) och kor i testlage.
#    Nyckeln ar hemlig — den ligger bara har, aldrig i chatten eller i git.
#    Skapa katalogen med: npm run stripe:plan  (torrkorning)
#                         npm run stripe:apply (skapar produkter, priser, momssatser, betallankar)
STRIPE_SECRET_KEY=

# ── Saljarens momsregistreringsnummer (fakturans fottext).
#    For enskild firma: SE + personnummer (10 siffror) + 01.
#    Lamnas tomt far fakturan en varning om att momsreg.nr saknas.
SELLER_VAT_NR=

# ── Valfritt: Redis (Upstash) i stallet for lokal fil.
#    Samma nyckelformat som n8n-workflowet: abuse:<adress>, summary:<adress>
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Valfritt: sokvag till den lokala tillstandsfilen
# AGENT_STATE_FILE=agents/.state.json
